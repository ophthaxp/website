# Public site URL (used for canonical, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://ophthaxp.com

# Backend API base (proxied through /api/* route handlers)
API_BASE_URL=https://api.ophthaxp.com

# Nocode backend (public module endpoint) — used to fetch courses created in the admin panel
NOCODE_API_BASE_URL=http://localhost:3000
NOCODE_APP_ID=2
NOCODE_COURSES_MODULE=courses
NOCODE_DOCTORS_MODULE=doctors
# Lead capture modules (created in the admin panel as isPublic modules)
NOCODE_APPLY_LEADS_MODULE=ophthaxp_apply_leads
NOCODE_BROCHURE_LEADS_MODULE=ophthaxp_brochure_leads
NOCODE_WAITLIST_MODULE=ophthaxp_waitlist
# Real user id from the nocode users table; used as created_by on each lead record
NOCODE_LEADS_USER_ID=

# Hero video on the home page (override with your own trailer URL)
NEXT_PUBLIC_HERO_VIDEO_SRC=

# AI assistant (Smart Assistance section)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Newsletter / lead capture provider (optional)
LEADS_WEBHOOK_URL=

# ── Legal entity details (shown on /terms, /privacy, /refunds, /contact) ──
# All optional. If a key is blank or absent, src/lib/legal.ts falls back to the
# real registered details shipped in that file — these only override.
# NOTE: the legal pages are statically rendered, so a change needs a redeploy.
# ⚠️ Keep the double quotes. An unquoted value starting with # is read as a
# comment and silently becomes empty (verified against Next's env parser).
LEGAL_ENTITY_NAME="Medxpanse Private Limited"
LEGAL_BRAND_NAME="Legends of Medicine"
# Address lines separated by | (env vars cannot hold arrays)
LEGAL_REGISTERED_ADDRESS="#714A, Suite No. 30J|Spencer Plaza, Phase II, 7th Floor|#769, Anna Salai, Thousand Lights|Chennai – 600002, Tamil Nadu, India"
LEGAL_SUPPORT_EMAIL="admissions@legendsofmedicine.com"
LEGAL_SUPPORT_PHONE="+91 88701 05999"
LEGAL_SUPPORT_HOURS="Monday to Friday, 10:00 – 18:00 IST"
# TODO — still blocking Razorpay activation, no fallback exists for these:
LEGAL_PRIVACY_EMAIL=
LEGAL_GRIEVANCE_NAME=
LEGAL_GRIEVANCE_DESIGNATION="Grievance Officer"
LEGAL_GRIEVANCE_EMAIL=
# Bump when the policy text changes materially
LEGAL_LAST_UPDATED="20 August 2026"

# ── Applicant login (apply flow) ──
# Signs the session cookie the apply flow sets. 32+ chars, and changing it logs
# everyone out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# The module holding half-finished applications (see ophthaxp-modules/applications.module.json)
NOCODE_APPLICATIONS_MODULE=ophthaxp_applications
